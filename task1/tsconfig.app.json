{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true,

    "strict": false,
    "allowJs": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "ignoreDeprecations": "6.0"
  },
  "include": ["App.tsx", "src"],
  "exclude": ["node_modules"]
}